{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${mod_version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": [
        "${mod_authors}"
    ],
    "contact": {
        "sources": "https://github.com/Octagon-Modding/Pufferfish-API"
    },
    "license": "${mod_license}",
    "environment": "*",
    "entrypoints": {
        "main": [
            "org.eu.awesomekalin.pufferfishapi.PufferfishAPI"
        ]
    },
    "depends": {
        "fabricloader": ">=${loader_version}",
        "minecraft": "=${minecraft_version}",
        "java": ">=21",
        "fabric-api": "*"
    },
    "icon": "icon.png",
    "mixins": [
        "pufferfishapi.mixins.json"
    ],
    "accessWidener": "pufferfishapi.classtweaker"
}